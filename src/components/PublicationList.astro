---
import { isMe, type Publication } from '../data/publications';

interface Props { items: Publication[] }
const { items } = Astro.props;
---

<ol class="pubs">
  {items.map((p) => (
    <li>
      <span class="year">{p.year}</span>
      <div>
        <span class="tag">{p.type}</span>
        <h3>{p.title}</h3>
        <p class="authors">
          {p.authors.map((a, i) => (
            <>
              {isMe(a) ? <strong>{a}</strong> : a}{i < p.authors.length - 1 ? ', ' : ''}
            </>
          ))}
        </p>
        <p class="venue">{p.venue}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .pubs { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 4.5rem 1fr; gap: .25rem 1.25rem; padding: 1.25rem 0; border-top: 1px solid var(--line); }
  li:first-child { border-top: 0; padding-top: 0; }
  .year { font: 700 1.1rem var(--sans); color: var(--blue); }
  .tag { display: inline-block; font: 600 .7rem var(--sans); letter-spacing: .08em; text-transform: uppercase; background: var(--sky); color: var(--blue-600); padding: .15rem .55rem; border-radius: 999px; }
  h3 { margin: .4rem 0 .35rem; font-size: 1.1rem; }
  .authors { margin: 0; font-size: .95rem; }
  .authors strong { color: var(--navy); }
  .venue { margin: .2rem 0 0; font-size: .95rem; font-style: italic; color: var(--muted); }
  @media (max-width: 560px) { li { grid-template-columns: 1fr; } }
</style>
