---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Dante D. Sánchez-Gallegos, Assistant Professor at Universidad Carlos III de Madrid (ARCOS research group). Research on the cloud-edge continuum, serverless computing and data management for data science.' } = Astro.props;
const fullTitle = title ? `${title} | Dante D. Sánchez-Gallegos` : 'Dante D. Sánchez-Gallegos | Assistant Professor, UC3M';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Dante D. Sánchez-Gallegos" />
    <meta name="theme-color" content="#0a2351" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: -999px; top: 0; background: var(--white); padding: .5rem 1rem; z-index: 100; }
  .skip:focus { left: 0; }
</style>
